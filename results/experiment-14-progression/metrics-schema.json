{
  "schema_version": "experiment-14.v1",
  "format": "gzip-compressed JSON Lines; exactly one object per controller decision",
  "decision_indexing": "zero based; checkpoint boundary after a decision is decision + 1",
  "null_policy": "null denotes a value unavailable by design for that condition",
  "fields": {
    "schema_version": "string",
    "experiment": "integer",
    "condition": "live_full | live_no_a | frozen_full | no_vision_full | long_run",
    "seed": "integer CNS seed",
    "decision": "contiguous zero-based integer",
    "simulated_time_s": "(decision + 1) * 0.2",
    "elapsed_run_s": "wall-clock seconds since active trial loop began",
    "action": "LEFT | RIGHT | UP | A | null",
    "previous_action": "LEFT | RIGHT | UP | A | null",
    "controller.selected_action": "same action chosen by FrozenInterfaceController",
    "controller.arbitration_reason": "event-first or directional threshold/deadband/cooldown reason",
    "DNa02.left_rate_hz": "raw summed left-side rate",
    "DNa02.right_rate_hz": "raw summed right-side rate",
    "DNa02.steering_signal_hz": "frozen-baseline steering signal",
    "DNa02.baseline_left_hz": "frozen pretrial value",
    "DNa02.baseline_right_hz": "frozen pretrial value",
    "DNa02.threshold_hz": "frozen symmetric steering threshold",
    "DNa02.normalized_excess": "absolute steering magnitude / threshold - 1",
    "DNg100.rate_hz": "raw population rate",
    "DNg100.baseline_hz": "frozen pretrial population mean",
    "DNg100.delta_hz": "rate minus baseline",
    "DNg100.threshold_hz": "frozen UP threshold",
    "DNg100.normalized_excess": "delta / threshold - 1",
    "P20.population_size": "20",
    "P20.rms_z": "one-window frozen-baseline population RMS z",
    "P20.threshold": "1.5",
    "P20.hysteresis": "0.5",
    "P20.armed": "decoder armed state, or null for BCI ablation",
    "P20.refractory_remaining": "integer decisions",
    "P20.event_fired": "true only when A is emitted",
    "P20.refractory_suppressions": "cumulative integer",
    "action_state.A_enabled": "boolean",
    "action_state.DOWN_enabled": "false",
    "action_state.hold_frames": "8",
    "action_state.release_frames": "4",
    "visual_analysis.input_frame_sha256": "sensory-input frame hash; null for no vision",
    "visual_analysis.resulting_frame_sha256": "post-action RGBA framebuffer hash",
    "visual_analysis.coarse_state_hash": "post-action quantized 18x20 visual-state hash",
    "visual_analysis.frame_to_previous_mae": "normalized post-action RGB MAE to the prior resulting frame; null at decision 0 in retained trials because the exact first result was not persisted losslessly for correction",
    "visual_analysis.frame_to_initial_mae": "normalized post-action RGB MAE",
    "visual_analysis.mean_luminance": "post-action RGB mean / 255",
    "visual_analysis.luminance_std": "post-action RGB standard deviation / 255",
    "trajectory.unique_coarse_states_so_far": "integer",
    "trajectory.coarse_transition_count_so_far": "integer",
    "trajectory.repeated_state_run_length": "integer",
    "trajectory.longest_repeated_state_run_so_far": "integer"
  }
}
